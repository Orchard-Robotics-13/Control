<?xml version="1.0"?>
<sdf version="1.8">
  <model name="citrus_tree">
    <static>true</static>
    <link name="link">

      <!-- Trunk -->
      <visual name="trunk_visual">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.3</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.18 0.13 0.08 1</ambient>
          <diffuse>0.28 0.20 0.13 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>

      <collision name="trunk_col">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.3</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Canopy -->
      <visual name="canopy_visual">
        <pose>0 0 0.9 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.6</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.09 0.28 0.09 1</ambient>
          <diffuse>0.16 0.38 0.12 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <collision name="canopy_col">
        <pose>0 0 0.9 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.6</radius>
          </sphere>
        </geometry>
      </collision>

      <!-- ArUco marker plaques: 15 total across 3 latitude rings on the
           canopy sphere (4 upper / 5 equatorial / 6 lower), each tangent
           to the sphere and facing outward radially. Each ring's azimuth
           start is offset 37 deg from the previous ring (upper=0,
           equator=37, lower=74) so markers don't stack vertically-->
           
      <!-- Upper ring: 4 markers at 40 deg elevation, azimuth offset 0 deg -->
      <visual name="aruco_marker_01">
        <pose>0.4615 0.0 1.2873 0 0.8727 0.0</pose>
        <geometry>
          <box>
            <size>0.15 0.15 0.005</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://citrus_tree/materials/textures/aruco_01.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="aruco_marker_02">
        <pose>0.0 0.4615 1.2873 0 0.8727 1.5708</pose>
